# Linux -> Windows x64 cross-toolchain. Put the MinGW binaries on PATH and pass
# CMAKE_PREFIX_PATH=<Windows Qt kit>, QT_HOST_PATH=<same-version Linux Qt kit>.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
find_program(IMSPROG_MINGW_CC NAMES x86_64-w64-mingw32-gcc-posix x86_64-w64-mingw32-gcc REQUIRED)
find_program(IMSPROG_MINGW_CXX NAMES x86_64-w64-mingw32-g++-posix x86_64-w64-mingw32-g++ REQUIRED)
find_program(IMSPROG_MINGW_RC NAMES x86_64-w64-mingw32-windres REQUIRED)
set(CMAKE_C_COMPILER "${IMSPROG_MINGW_CC}")
set(CMAKE_CXX_COMPILER "${IMSPROG_MINGW_CXX}")
set(CMAKE_RC_COMPILER "${IMSPROG_MINGW_RC}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
