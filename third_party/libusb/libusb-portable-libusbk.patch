+/* IMSProg portable userspace build, 2026-10-06: allow only an absolute
+ * executable-directory libusbK.dll before the upstream System32 fallback.
+ * Never search the current directory or PATH, and never install a driver. */
+static HMODULE load_portable_libusbk(struct libusb_context *ctx)
+{
+	const DWORD capacity = 32768;
+	wchar_t *path = calloc(capacity, sizeof(*path));
+	HMODULE module = NULL;
+	if (path != NULL) {
+		DWORD length = GetModuleFileNameW(NULL, path, capacity);
+		if (length > 0 && length < capacity) {
+			wchar_t *separator = wcsrchr(path, L'\\');
+			if (separator != NULL &&
+				(size_t)(separator + 1 - path) + 12 < capacity) {
+				wcscpy(separator + 1, L"libusbK.dll");
+				module = LoadLibraryExW(path, NULL,
+					LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+				if (module != NULL)
+					usbi_info(ctx, "using executable-directory libusbK.dll");
+			}
+		}
+		free(path);
+	}
+	return module != NULL ? module : load_system_library(ctx, "libusbK");
+}
